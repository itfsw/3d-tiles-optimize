{
  "name": "3d-tiles-optimize",
  "version": "0.0.5",
  "description": "Optimize 3d-tiles by 3d-tiles-tools with glTF-Transform",
  "keywords": [
    "3d-tiles",
    "3d-tiles-tools",
    "glTF-Transform",
    "optimize"
  ],
  "license": "Apache-2.0",
  "repository": "github:itfsw/3d-tiles-optimize",
  "private": false,
  "type": "module",
  "types": "./dist/cli.d.mts",
  "exports": {
    "types": "./dist/cli.d.mts",
    "default": "./dist/cli.mjs"
  },
  "bin": {
    "3d-tiles-optimize": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsdown src/cli.ts",
    "build:watch": "tsdown src/cli.ts --watch",
    "test": "3d-tiles-optimize optimize ./data/input ./data/output --logLevel trace"
  },
  "dependencies": {
    "@donmccurdy/caporal": "^0.0.10",
    "@gltf-transform/cli": "^4.3.0",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "3d-tiles-tools": "^0.5.1",
    "draco3dgltf": "^1.5.7",
    "keyframe-resample": "^0.1.0",
    "meshoptimizer": "^1.0.1",
    "micromatch": "^4.0.8",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/draco3dgltf": "^1.4.3",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^25.2.1",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE.md",
    "package-lock.json"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
